---
// Components index. The CATALOG stays in Storybook (it is not duplicated
// here) — this page is an index into it, plus one live React island proving
// the second delivery layer on the site itself.
//
// The list is generated at build time from the installed `@yasmro/schatten`
// package: every lv1 that ships a per-component CSS subpath. The site has no
// view of the library source, so it can only list what is published.
//
// Built from Schatten's React components (Text / Badge / Card / Button),
// rendered to static HTML at build time; only <LiveDemo> hydrates. See CLAUDE.md.
import { Badge, Card, CardContent, CardDescription, CardHeader, CardTitle, Text } from '@yasmro/schatten'
import LinkButton from '../../components/LinkButton'
import LiveDemo from '../../components/LiveDemo'
import Base from '../../layouts/Base.astro'
import { defaultLocale, type Locale, locales, ui } from '../../i18n/ui'
import { listComponents } from '../../lib/library.mjs'
import { STORYBOOK_ORIGIN, storybookDocsUrl } from '../../lib/storybook-links.mjs'

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))
}

const { locale } = Astro.props as { locale: Locale }
const t = ui[locale].components

const components = (await listComponents()).map(({ name }) => ({
  name,
  // Derivation + drift gate live in src/lib/storybook-links.mjs
  // (scripts/check-storybook-links.mjs checks these against the deployed Storybook).
  href: storybookDocsUrl(name),
}))
---

<Base locale={locale} description={t.metaDescription} title={t.pageTitle} page="components">
  <main class="page">
    <section class="intro">
      <Text as="h1" variant="heading" size="2xl" family="serif">{t.title}</Text>
      <Text
        as="p"
        size="lg"
        color="muted"
        leading="relaxed"
        className="intro__lead"
        set:html={t.lead.replace('%STORYBOOK%', STORYBOOK_ORIGIN)}
      />
    </section>

    <section>
      <Card>
        <CardHeader>
          <CardTitle>{t.liveTitle}</CardTitle>
          <CardDescription>{t.liveDesc}</CardDescription>
        </CardHeader>
        <CardContent>
          <LiveDemo
            client:visible
            saveLabel={t.saveLabel}
            savingDoneLabel={t.savingDoneLabel}
            switchLabel={t.switchLabel}
            errorToggleLabel={t.errorToggleLabel}
            inputPlaceholder={t.inputPlaceholder}
          />
        </CardContent>
      </Card>
    </section>

    <section class="list">
      <div class="list__heading">
        <Text as="h2" variant="heading" size="lg" family="serif">{t.listTitle}</Text>
        <Badge variant="neutral" appearance="outline" size="sm">{components.length}</Badge>
      </div>
      <Text as="p" size="sm" color="muted" leading="relaxed" className="list__lead" set:html={t.listLead} />
      <ul class="list__grid">
        {
          components.map((c) => (
            <li>
              <LinkButton variant="secondary" size="md" href={c.href} className="list__item">
                {c.name}
              </LinkButton>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Base>

<style is:global>
  /* LAYOUT only — type / color / controls come from the components. */
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .intro__lead {
    max-width: 44rem;
  }

  .list__heading {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    margin-bottom: var(--spacing-3);
  }

  .list__lead {
    max-width: 44rem;
    margin-bottom: var(--spacing-6);
  }

  .list__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--spacing-2);
  }

  /* A secondary Button stretched to its grid cell; the look is the Button's. */
  .list__item {
    width: 100%;
    justify-content: flex-start;
    text-decoration: none;
  }
</style>
