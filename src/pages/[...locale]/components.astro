---
// Components index: every component grouped by category, each linking to its
// own page (/components/[slug]). Storybook is linked as the place to verify
// and test behaviour, plus one live React island proving the second delivery
// layer on the site itself.
//
// The list is generated at build time from the installed `@yasmro/schatten`
// package: every lv1 that ships a per-component CSS subpath. The site has no
// view of the library source, so it can only list what is published.
//
// Built from Schatten's React components (Text / Badge / Card / Callout),
// rendered to static HTML at build time; only <LiveDemo> hydrates. See CLAUDE.md.
import {
  Badge,
  Callout,
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
  Text,
} from '@yasmro/schatten'
import LiveDemo from '../../components/LiveDemo'
import Base from '../../layouts/Base.astro'
import { groupByCategory, guides } from '../../i18n/guides'
import { defaultLocale, type Locale, localePath, locales, ui } from '../../i18n/ui'
import { listComponents } from '../../lib/library.mjs'
import { STORYBOOK_ORIGIN } from '../../lib/storybook-links.mjs'

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))
}

const { locale } = Astro.props as { locale: Locale }
const t = ui[locale].components

const components = await listComponents()

// [slug].astro fails the build on a component with no guide, so `guides[slug]`
// is defined here for everything the package ships.
const categories = groupByCategory(components)
---

<Base locale={locale} description={t.metaDescription} title={t.pageTitle} page="components">
  <main class="page">
    <section class="intro">
      <Text as="h1" variant="heading" size="2xl" family="serif">{t.title}</Text>
      <Text as="p" size="lg" color="muted" leading="relaxed" className="intro__lead">{t.lead}</Text>
      <Text as="p" size="sm" color="muted" leading="relaxed" className="intro__lead" set:html={t.listLead} />
    </section>

    {
      categories.map((category) => (
        <section class="list">
          <div class="list__heading">
            <Text as="h2" variant="heading" size="lg" family="serif">{t.categories[category.id]}</Text>
            <Badge variant="neutral" appearance="outline" size="sm">{category.items.length}</Badge>
          </div>
          <ul class="list__grid">
            {category.items.map(({ slug, name }) => (
              <li>
                <a class="list__link" href={`${localePath(locale)}components/${slug}/`}>
                  <Card className="list__card">
                    <CardHeader>
                      <CardTitle>{name}</CardTitle>
                      <CardDescription>{guides[slug].summary[locale]}</CardDescription>
                    </CardHeader>
                  </Card>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section>
      <Callout variant="info" appearance="subtle" role="note" title={t.storybookTitle}>
        <Fragment slot="description" set:html={t.storybookNote.replace('%STORYBOOK%', STORYBOOK_ORIGIN)} />
      </Callout>
    </section>

    <section>
      <Card>
        <CardHeader>
          <CardTitle>{t.liveTitle}</CardTitle>
          <CardDescription>{t.liveDesc}</CardDescription>
        </CardHeader>
        <CardContent>
          <LiveDemo
            client:visible
            saveLabel={t.saveLabel}
            savingDoneLabel={t.savingDoneLabel}
            switchLabel={t.switchLabel}
            errorToggleLabel={t.errorToggleLabel}
            inputPlaceholder={t.inputPlaceholder}
          />
        </CardContent>
      </Card>
    </section>
  </main>
</Base>

<style is:global>
  /* LAYOUT only — type / color / controls come from the components. */
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .intro__lead {
    max-width: 44rem;
  }

  .list__heading {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    margin-bottom: var(--spacing-4);
  }

  .list__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--spacing-3);
  }

  .list__link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .list__card {
    height: 100%;
    box-sizing: border-box;
  }

  .list__link:hover .list__card {
    border-color: var(--color-border-strong);
  }
</style>
