---
// Brand concept page (#449 Phase 3). SSOT for the prose is
// docs/brand-concept.md — this page renders it; it does not own the concept.
//
// Values (ramps, seasons, type scale) are hand-copied from the tokens for the
// skeleton. Phase 3 should generate them from `dist/schatten.css` so the page
// cannot drift from the shipped values — see §6 of docs/brand-concept.md.
//
// Note: §4 of that document (the open question about the calligraphy
// provenance) is deliberately NOT rendered here — it stays internal until
// settled.
import Base from '../../layouts/Base.astro'
import { defaultLocale, type Locale, locales, ui } from '../../i18n/ui'

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))
}

const { locale } = Astro.props as { locale: Locale }
const t = ui[locale].brand

// ── Values, all from src/core/tokens/primitives.css (v1.0.0) ──

/** 朱 / 墨 / 和紙 / 藍 — the display chip for each of the four. */
const fourChips = [
  'oklch(0.555 0.205 30)',
  'oklch(0.18 0.01 250)',
  'oklch(0.96 0.008 70)',
  'oklch(0.46 0.15 265)',
]

const rungs = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950] as const

/** Sumi and alabaster share one L/C ladder; only the hue differs. */
const neutralLadder = [
  [0.98, 0.005],
  [0.96, 0.008],
  [0.91, 0.01],
  [0.83, 0.01],
  [0.71, 0.01],
  [0.58, 0.01],
  [0.48, 0.01],
  [0.37, 0.01],
  [0.27, 0.01],
  [0.18, 0.01],
  [0.12, 0.008],
] as const

const vermillionRamp = [
  'oklch(0.975 0.012 30)', 'oklch(0.95 0.025 30)', 'oklch(0.9 0.05 30)',
  'oklch(0.82 0.1 30)', 'oklch(0.72 0.172 30)', 'oklch(0.62 0.22 30)',
  'oklch(0.555 0.205 30)', 'oklch(0.46 0.165 30)', 'oklch(0.36 0.125 30)',
  'oklch(0.27 0.085 30)', 'oklch(0.155 0.05 30)',
]

const indigoRamp = [
  'oklch(0.97 0.014 265)', 'oklch(0.93 0.033 265)', 'oklch(0.86 0.07 265)',
  'oklch(0.77 0.11 265)', 'oklch(0.67 0.14 265)', 'oklch(0.55 0.16 265)',
  'oklch(0.46 0.15 265)', 'oklch(0.37 0.13 265)', 'oklch(0.28 0.1 265)',
  'oklch(0.2 0.07 265)', 'oklch(0.13 0.04 265)',
]

/** The 500 rung of each Special, in 八節 order. */
const seasons = [
  { swatch: 'oklch(0.62 0.10 12)', date: '2/4', hue: 'h12' },
  { swatch: 'oklch(0.62 0.10 138)', date: '3/21', hue: 'h138' },
  { swatch: 'oklch(0.62 0.09 162)', date: '5/6', hue: 'h162' },
  { swatch: 'oklch(0.62 0.11 45)', date: '6/21', hue: 'h45' },
  { swatch: 'oklch(0.62 0.085 230)', date: '8/7', hue: 'h230' },
  { swatch: 'oklch(0.62 0.10 70)', date: '9/23', hue: 'h70' },
  { swatch: 'oklch(0.62 0.048 250)', date: '11/7', hue: 'h250' },
  { swatch: 'oklch(0.62 0.08 255)', date: '12/22', hue: 'h255' },
]

const typeScale = [
  ['4xl', '2.25rem'], ['3xl', '1.875rem'], ['2xl', '1.5rem'], ['xl', '1.25rem'],
  ['lg', '1.125rem'], ['base', '1rem'], ['sm', '0.875rem'], ['xs', '0.75rem'],
]

const leadings = [
  ['none', '1'], ['tight', '1.25'], ['snug', '1.375'],
  ['normal', '1.5'], ['relaxed', '1.625'], ['loose', '2'],
]
---

<Base locale={locale} description={t.metaDescription} title={t.pageTitle} page="brand">
  <main class="brand">
    <header class="brand__masthead">
      <h1 class="brand__mark">陰影<span class="brand__gloss">Schatten · Brand Concept</span></h1>
      <p class="brand__thesis" set:html={t.thesis} />
      <p class="brand__origin" set:html={t.origin} />
    </header>

    <div class="brand__gradation" aria-hidden="true">
      <span class="brand__gradation-paper">{t.gradationPaper}</span>
      <span class="brand__gradation-ink">{t.gradationInk}</span>
    </div>

    <div class="brand__body">
      <section>
        <div class="brand__eyebrow">
          <span class="brand__label">{t.colorLabel}</span>
        </div>
        <h2>{t.colorTitle}</h2>
        <p set:html={t.colorLead} />

        <div class="four">
          {
            t.colorSwatches.map((c, i) => (
              <div class="four__cell">
                <div class="four__chip" style={`background:${fourChips[i]}`} />
                <div>
                  <div class="four__name">{c.name}</div>
                  <div class="four__token">{c.token}</div>
                </div>
                <div class="four__role">{c.role}</div>
              </div>
            ))
          }
        </div>

        <h3>{t.warmCoolTitle}</h3>
        <p set:html={t.warmCoolLead} />

        <div class="warmcool" aria-hidden="true">
          <div class="warmcool__head" />
          <div class="warmcool__head">{t.warmLabel}</div>
          <div class="warmcool__head">{t.coolLabel}</div>
          <div class="warmcool__rowhead">{t.achromaticLabel}</div>
          <div><span class="dot" style="background:oklch(0.96 0.008 70)" />washi · h70</div>
          <div><span class="dot" style="background:oklch(0.58 0.01 250)" />sumi · h250</div>
          <div class="warmcool__rowhead">{t.chromaticLabel}</div>
          <div><span class="dot" style="background:oklch(0.555 0.205 30)" />vermillion · h30</div>
          <div><span class="dot" style="background:oklch(0.46 0.15 265)" />indigo · h265</div>
        </div>

        <h4>{t.mirrorTitle}</h4>
        <p set:html={t.mirrorLead} />

        <div class="ramps" aria-hidden="true">
          <div class="ramps__row">
            <span class="ramps__name">墨 h250</span>
            <div class="ramps__ramp">
              {neutralLadder.map(([l, c]) => <span style={`background:oklch(${l} ${c} 250)`} />)}
            </div>
          </div>
          <div class="ramps__row">
            <span class="ramps__name">和紙 h70</span>
            <div class="ramps__ramp">
              {neutralLadder.map(([l, c]) => <span style={`background:oklch(${l} ${c} 70)`} />)}
            </div>
          </div>
          <div class="ramps__row">
            <span />
            <div class="ramps__axis">{rungs.map((r) => <span>{r}</span>)}</div>
          </div>
        </div>

        <h4>{t.chromaticRampTitle}</h4>
        <div class="ramps" aria-hidden="true">
          <div class="ramps__row">
            <span class="ramps__name">朱 h30</span>
            <div class="ramps__ramp">
              {vermillionRamp.map((c) => <span style={`background:${c}`} />)}
            </div>
          </div>
          <div class="ramps__row">
            <span class="ramps__name">藍 h265</span>
            <div class="ramps__ramp">{indigoRamp.map((c) => <span style={`background:${c}`} />)}</div>
          </div>
        </div>
        <p class="brand__note" set:html={t.oklchNote} />
      </section>

      <hr class="brand__hr" />

      <section>
        <div class="brand__eyebrow">
          <span class="brand__label">{t.seasonsLabel}</span>
        </div>
        <h2>{t.seasonsTitle}</h2>
        <p set:html={t.seasonsLead} />
      </section>
    </div>

    {/* 装飾ではなくデータ(節気 × 日付 × 色相)を運ぶので aria-hidden にしない。
        純装飾のランプ・グラデ帯・寒暖表(値は本文にある)だけが hidden。 */}
    <ul class="brand__seasons">
      {
        seasons.map((s, i) => (
          <li class="brand__season" style={`background:${s.swatch}`}>
            <span class="brand__sekki">{t.seasonNames[i]}</span>
            <span class="brand__date">{s.date}</span>
            <span class="brand__hue">{s.hue}</span>
          </li>
        ))
      }
    </ul>
    <p class="brand__strip-note">{t.seasonsNote}</p>

    <div class="brand__body">
      <section>
        <div class="brand__eyebrow">
          <span class="brand__label">{t.typeLabel}</span>
        </div>
        <h2>{t.typeTitle}</h2>
        <p set:html={t.typeLead1} />
        <p set:html={t.typeLead2} />

        <div class="faces">
          <div class="faces__cell faces__cell--sans">
            <span class="faces__role">{t.faceSansRole}</span>
            <span class="faces__latin" set:html={t.faceSampleLatin} />
            <span class="faces__ja">{t.faceSampleJa}</span>
            <div class="faces__names">Hanken Grotesk<br />LINE Seed JP</div>
          </div>
          <div class="faces__cell faces__cell--serif">
            <span class="faces__role">{t.faceSerifRole}</span>
            <span class="faces__latin" set:html={t.faceSampleLatin} />
            <span class="faces__ja">{t.faceSampleJa}</span>
            <div class="faces__names">EB Garamond<br />Noto Serif JP</div>
          </div>
        </div>

        <h3>{t.scaleTitle}</h3>
        <p set:html={t.scaleLead} />

        <div class="specimen">
          {
            typeScale.map(([name, size]) => (
              <div class="specimen__row">
                <span class="specimen__tok">
                  {name} · {size.replace('rem', '')}
                </span>
                <span class="specimen__sample" style={`font-size:${size}`}>
                  {t.scaleSample}
                </span>
              </div>
            ))
          }
        </div>

        <div class="leadings">
          {
            leadings.map(([name, value]) => (
              <div>
                <span class="leadings__tok">
                  {name} · {value}
                </span>
                <p style={`line-height:${value}`}>{t.scaleSample}</p>
              </div>
            ))
          }
        </div>

        <p class="brand__note" set:html={t.roleNote} />
      </section>

    </div>
  </main>
</Base>

<style>
  /* The brand page sets its own rhythm: serif prose on a narrower measure than
   * the landing, because it is read rather than scanned. */
  .brand {
    flex: 1;
    /* 本文は sans。見出し・ディスプレイだけが serif に切り替わる。 */
    font-family: var(--font-sans);
    line-height: 1.85;
  }

  .brand__body {
    max-width: 40rem;
    margin-inline: auto;
    padding-inline: var(--spacing-8);
  }

  .brand__masthead {
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--spacing-16) var(--spacing-8) var(--spacing-8);
  }

  .brand__mark {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .brand__gloss {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
    margin-top: var(--spacing-4);
  }

  .brand__thesis {
    margin: var(--spacing-12) 0 0;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 1.65;
    text-wrap: balance;
    word-break: auto-phrase;
  }

  .brand__thesis :global(em) {
    font-style: normal;
    color: var(--color-vermillion);
  }

  /* Plain-language counterpart to the thesis above — sans, small, muted.
   * Deliberately unpoetic: it states the German name and the source essay
   * as fact, not metaphor. */
  .brand__origin {
    margin: var(--spacing-4) 0 0;
    max-width: 36rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-foreground-muted);
  }

  .brand__origin :global(em) {
    font-style: italic;
  }

  /* The thesis, drawn: paper on the left, ink on the right. */
  .brand__gradation {
    margin-top: var(--spacing-12);
    height: 8rem;
    background: linear-gradient(
      90deg,
      oklch(0.98 0.005 70) 0%,
      oklch(0.91 0.01 70) 34%,
      oklch(0.58 0.01 250) 62%,
      oklch(0.27 0.01 250) 88%,
      oklch(0.18 0.01 250) 100%
    );
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: var(--spacing-3) var(--spacing-4);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
  }

  .brand__gradation-paper {
    color: oklch(0.37 0.01 70);
  }
  .brand__gradation-ink {
    color: oklch(0.91 0.01 70);
  }

  .brand section {
    padding-block: var(--spacing-16);
  }

  .brand__eyebrow {
    margin-bottom: var(--spacing-3);
  }

  .brand__label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .brand h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight, 1.25);
    text-wrap: balance;
  }

  .brand h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-xl);
    margin: var(--spacing-10) 0 var(--spacing-2);
  }

  .brand h4 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-lg);
    margin: var(--spacing-8) 0 var(--spacing-2);
  }

  .brand p {
    margin: var(--spacing-4) 0;
  }

  .brand :global(strong) {
    font-weight: 400;
    color: var(--color-vermillion);
  }

  .brand :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-foreground-muted);
  }

  .brand__note {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-foreground-muted);
  }

  .brand__hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 0;
  }

  /* ---- four colors ---- */
  .four {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    margin: var(--spacing-6) 0;
  }

  .four__cell {
    background: var(--color-surface);
    padding: var(--spacing-4);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .four__chip {
    height: 3.4rem;
    border-radius: var(--radius-control);
  }

  .four__name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
  }

  .four__token {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--color-foreground-muted);
  }

  .four__role {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--color-foreground-muted);
  }

  /* ---- warm / cool ---- */
  .warmcool {
    display: grid;
    grid-template-columns: auto 1fr 1fr;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    font-family: var(--font-sans);
    margin: var(--spacing-6) 0;
  }

  .warmcool > div {
    background: var(--color-surface);
    padding: var(--spacing-3);
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  .warmcool__head {
    color: var(--color-foreground-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: var(--text-xs) !important;
    justify-content: center;
  }

  .warmcool__rowhead {
    color: var(--color-foreground-muted);
    font-size: var(--text-xs) !important;
  }

  .dot {
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    flex: none;
  }

  /* ---- ramps ---- */
  .ramps {
    margin: var(--spacing-6) 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1, 0.25rem);
  }

  .ramps__row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    align-items: center;
    gap: var(--spacing-3);
  }

  .ramps__name {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-foreground-muted);
    text-align: right;
  }

  .ramps__ramp {
    display: grid;
    grid-template-columns: repeat(11, 1fr);
  }

  .ramps__ramp span {
    height: 2.1rem;
  }

  .ramps__axis {
    display: grid;
    grid-template-columns: repeat(11, 1fr);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-foreground-subtle);
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* ---- seasons ---- */
  .brand__seasons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
  }

  .brand__season {
    aspect-ratio: 3 / 4;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--spacing-2);
    gap: 0.1rem;
    color: oklch(0.98 0.005 70);
  }

  .brand__sekki {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    line-height: 1.2;
  }

  .brand__date {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    opacity: 0.9;
    font-variant-numeric: tabular-nums;
  }

  .brand__hue {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    opacity: 0.72;
  }

  .brand__strip-note {
    font-size: var(--text-sm);
    color: var(--color-foreground-muted);
    text-align: center;
    padding: var(--spacing-4) var(--spacing-8);
    margin: 0;
    line-height: 1.6;
  }

  /* ---- faces ---- */
  .faces {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    margin: var(--spacing-6) 0;
  }

  .faces__cell {
    background: var(--color-surface);
    padding: var(--spacing-4);
  }

  .faces__role {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
    display: block;
    margin-bottom: var(--spacing-3);
  }

  .faces__latin {
    font-size: var(--text-2xl);
    line-height: 1.2;
    display: block;
  }

  .faces__ja {
    font-size: var(--text-xl);
    line-height: 1.5;
    display: block;
  }

  .faces__names {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-foreground-muted);
    margin-top: var(--spacing-3);
    line-height: 1.5;
  }

  .faces__cell--sans .faces__latin,
  .faces__cell--sans .faces__ja {
    font-family: var(--font-sans);
  }

  .faces__cell--serif .faces__latin,
  .faces__cell--serif .faces__ja {
    font-family: var(--font-serif);
  }

  /* ---- type specimen ---- */
  .specimen {
    border-top: 1px solid var(--color-border);
    margin: var(--spacing-6) 0;
  }

  .specimen__row {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--spacing-4);
    align-items: baseline;
    padding: var(--spacing-2) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .specimen__tok {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-foreground-muted);
    font-variant-numeric: tabular-nums;
  }

  .specimen__sample {
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .leadings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    margin: var(--spacing-6) 0;
  }

  .leadings > div {
    background: var(--color-surface);
    padding: var(--spacing-3);
  }

  .leadings__tok {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-foreground-muted);
    display: block;
    margin-bottom: var(--spacing-2);
  }

  .leadings p {
    font-size: var(--text-sm);
    margin: 0;
  }

  @media (max-width: 40rem) {
    .four,
    .faces {
      grid-template-columns: 1fr 1fr;
    }
    .brand__seasons {
      grid-template-columns: repeat(4, 1fr);
    }
    .ramps__row {
      grid-template-columns: 3rem 1fr;
    }
  }
</style>
