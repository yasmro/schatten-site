---
// Landing. Shell, theme plumbing, and chrome live in Base.astro; this file
// owns the landing's own content and styles.
//
// Built from Schatten's React components (Text / Button / Badge / Card /
// Callout), rendered to static HTML at build time — see CLAUDE.md. The one
// place raw `.st-*` markup is written by hand is the "Vanilla HTML" pane of
// the proof block, because showing that markup IS the point of the pane.
//
// i18n: rest-param route — `/` renders the default locale (en), `/ja/` the
// Japanese variant. Copy lives in src/i18n/ui.ts; this template is shared.
import {
  Badge,
  Button,
  Callout,
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
  Text,
} from '@yasmro/schatten'
import CodeBlock from '../../components/CodeBlock.astro'
import LinkButton from '../../components/LinkButton'
import Base from '../../layouts/Base.astro'
import { defaultLocale, type Locale, localePath, locales, ui } from '../../i18n/ui'
import { libraryVersion } from '../../lib/library.mjs'

// Version badge = the installed `@yasmro/schatten` version. The site depends
// on the npm package, so this always names a published release.
const version = libraryVersion()

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))
}

const { locale } = Astro.props as { locale: Locale }
const t = ui[locale].landing

const reactSample = `<Button variant="primary"
  size="md">
  ${t.proofRenderButton}
</Button>`
const htmlSample = `<button class="st-btn
  st-btn--primary st-btn--md">
  ${t.proofRenderButton}
</button>`
---

<Base locale={locale} description={t.metaDescription}>
  <main class="page landing">
    <section class="hero">
      {/* 言語に依らないワードマーク。h1 は見出しのままで、これはブランド標識。 */}
      <Text as="p" variant="heading" size="2xl" family="serif" className="hero__wordmark">Schatten</Text>
      <Text as="h1" variant="heading" size="lg" family="serif" className="hero__title">{t.heroTitle}</Text>
      <Text as="p" size="lg" color="muted" leading="relaxed" className="hero__lead" set:html={t.heroLead} />

      <div class="hero__actions">
        {/* 暫定リンク: サイト内 getting-started ページが立つまで README へ飛ばす。 */}
        <LinkButton variant="primary" size="lg" href="https://github.com/yasmro/schatten#getting-started">
          {t.ctaGetStarted}
        </LinkButton>
        <LinkButton variant="secondary" size="lg" href={`${localePath(locale)}components/`}>
          {t.ctaComponents}
        </LinkButton>
      </div>

      <div class="hero__badges">
        <Badge variant="neutral" appearance="solid">v{version}</Badge>
        <Badge variant="success" appearance="subtle">API stable</Badge>
        <Badge variant="info" appearance="outline">ESM only</Badge>
      </div>
    </section>

    <!-- Proof block: the two delivery layers, side by side, one render. -->
    <section class="proof">
      <Card>
        <CardHeader>
          <CardTitle>{t.proofTitle}</CardTitle>
          <CardDescription>{t.proofDesc}</CardDescription>
        </CardHeader>
        <CardContent className="proof__content">
          <figure class="proof__pane">
            <figcaption>
              <Text as="span" variant="label" size="xs" color="subtle" className="proof__caption">React</Text>
            </figcaption>
            <CodeBlock code={reactSample} lang="tsx" />
          </figure>
          <figure class="proof__pane">
            <figcaption>
              <Text as="span" variant="label" size="xs" color="subtle" className="proof__caption">Vanilla HTML</Text>
            </figcaption>
            <CodeBlock code={htmlSample} lang="html" />
          </figure>
          <div class="proof__render">
            <Text as="span" variant="label" size="xs" color="subtle" className="proof__caption">
              {t.proofRenderLabel}
            </Text>
            {/* The React half of the proof, rendered for real by the component. */}
            <Button type="button" variant="primary" size="md">{t.proofRenderButton}</Button>
          </div>
        </CardContent>
        <CardFooter className="proof__footer">
          <Text as="p" size="sm" color="muted" set:html={t.proofFooter} />
        </CardFooter>
      </Card>
    </section>

    <section>
      <Callout variant="info" appearance="subtle" role="note">
        <Fragment slot="description" set:html={t.calloutNote} />
      </Callout>
    </section>
  </main>
</Base>

<style is:global>
  /* Landing LAYOUT only — type / color come from the components. */
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  /* ブランドページの「Schatten + gloss」と同じ階層。マークが主、文言が従。 */
  .hero__wordmark {
    margin: 0 0 calc(var(--spacing-8) * -1 + var(--spacing-4));
  }

  .hero__title {
    text-wrap: balance;
    /* Progressive enhancement (Chromium 119+): phrase-based JP wrapping so
     * カタカナ語 don't break mid-word. Falls back to normal wrapping. */
    word-break: auto-phrase;
  }

  .hero__lead {
    max-width: 44rem;
  }

  .hero__actions {
    display: flex;
    gap: var(--spacing-4);
    flex-wrap: wrap;
  }

  .hero__actions a {
    text-decoration: none;
  }

  .hero__badges {
    display: flex;
    gap: var(--spacing-3);
    flex-wrap: wrap;
    align-items: center;
  }

  /* ---- proof block ---- */
  .proof__content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-4);
  }

  .proof__pane {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .proof__caption {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .proof__render {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    padding-top: var(--spacing-2);
    border-top: 1px dashed var(--color-border);
  }

  @media (max-width: 40rem) {
    .proof__content {
      grid-template-columns: 1fr;
    }
  }
</style>
