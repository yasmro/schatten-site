---
// Landing (#449 Phase 2). Shell, theme plumbing, and chrome live in Base.astro;
// this file owns the landing's own content and styles.
//
// i18n: rest-param route — `/` renders the default locale (en), `/ja/` the
// Japanese variant. Copy lives in src/i18n/ui.ts; this template is shared.
import Base from '../../layouts/Base.astro'
import { defaultLocale, type Locale, locales, ui } from '../../i18n/ui'
import { libraryVersion } from '../../lib/library.mjs'
import { STORYBOOK_ORIGIN } from '../../lib/storybook-links.mjs'

// Version badge = the installed `@yasmro/schatten` version. The site depends
// on the npm package, so this always names a published release.
const version = libraryVersion()

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))
}

const { locale } = Astro.props as { locale: Locale }
const t = ui[locale].landing
---

<Base locale={locale} description={t.metaDescription}>
  <main class="page">
    <section class="hero">
      {/* 言語に依らないワードマーク。h1 は見出しのままで、これはブランド標識。 */}
      <p class="hero__wordmark">Schatten</p>
      <h1 class="hero__title">{t.heroTitle}</h1>
      <p class="hero__lead" set:html={t.heroLead} />

      <div class="hero__actions">
        {/* 暫定リンク: サイト内 getting-started ページ(#449 Phase 3)が
            立つまで README へ飛ばす。Phase 3 で差し替えること。 */}
        <a
          href="https://github.com/yasmro/schatten#getting-started"
          class="st-btn st-btn--primary st-btn--lg"
        >
          {t.ctaGetStarted}
        </a>
        <a href={STORYBOOK_ORIGIN} class="st-btn st-btn--secondary st-btn--lg">
          {t.ctaStorybook}
        </a>
      </div>

      <div class="hero__badges">
        <span class="st-badge st-badge--neutral st-badge--solid st-badge--md">v{version}</span>
        <span class="st-badge st-badge--success st-badge--subtle st-badge--md">API stable</span>
        <span class="st-badge st-badge--info st-badge--outline st-badge--md">ESM only</span>
      </div>
    </section>

    <!-- Proof block: the two delivery layers, side by side, one render. -->
    <section class="proof">
      <div class="st-card st-card--filled proof__card">
        <div class="st-card__header">
          <div class="st-card__title">{t.proofTitle}</div>
          <div class="st-card__description">{t.proofDesc}</div>
        </div>
        <div class="st-card__content proof__content">
          <figure class="proof__pane">
            <figcaption class="proof__caption">React</figcaption>
            <pre
              class="proof__code"><code>&lt;Button variant="primary"
  size="md"&gt;
  {t.proofRenderButton}
&lt;/Button&gt;</code></pre>
          </figure>
          <figure class="proof__pane">
            <figcaption class="proof__caption">Vanilla HTML</figcaption>
            <pre
              class="proof__code"><code>&lt;button class="st-btn
  st-btn--primary st-btn--md"&gt;
  {t.proofRenderButton}
&lt;/button&gt;</code></pre>
          </figure>
          <div class="proof__render">
            <span class="proof__caption">{t.proofRenderLabel}</span>
            <button type="button" class="st-btn st-btn--primary st-btn--md">
              {t.proofRenderButton}
            </button>
          </div>
        </div>
        <div class="st-card__footer proof__footer" set:html={t.proofFooter} />
      </div>
    </section>


    <section class="callout-demo">
      <div class="st-callout st-callout--info st-callout--subtle" role="note">
        <div class="st-callout__body" set:html={t.calloutNote} />
      </div>
    </section>
  </main>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  /* ブランドページの「陰影 + gloss」と同じ階層。マークが主、文言が従。 */
  .hero__wordmark {
    margin: 0 0 calc(var(--spacing-8) * -1 + var(--spacing-4));
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    line-height: 1;
  }

  .hero__title {
    margin: 0;
    /* Headings ride the DS serif stack (EB Garamond / Noto Serif JP) — the
     * same `--font-serif` the Text component's `st-text--serif` consumes. */
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug, 1.375);
    text-wrap: balance;
    /* Progressive enhancement (Chromium 119+): phrase-based JP wrapping so
     * カタカナ語 don't break mid-word. Falls back to normal wrapping. */
    word-break: auto-phrase;
  }

  .hero__lead {
    margin: 0;
    max-width: 44rem;
    color: var(--color-foreground-muted);
    font-size: var(--text-lg);
    line-height: 1.8;
  }

  .hero__actions {
    display: flex;
    gap: var(--spacing-4);
    flex-wrap: wrap;
  }

  .hero__actions .st-btn {
    text-decoration: none;
  }

  .hero__badges {
    display: flex;
    gap: var(--spacing-3);
    flex-wrap: wrap;
    align-items: center;
  }

  /* ---- proof block ---- */
  .proof__content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-4);
  }

  .proof__pane {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .proof__caption {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground-subtle);
  }

  .proof__code {
    margin: 0;
    padding: var(--spacing-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.7;
    overflow-x: auto;
  }

  .proof__render {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    padding-top: var(--spacing-2);
    border-top: 1px dashed var(--color-border);
  }

  .proof__footer {
    /* .st-card__footer is a flex actions row by contract; this footer is
     * prose, so restore block flow. */
    display: block;
    color: var(--color-foreground-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 40rem) {
    .proof__content {
      grid-template-columns: 1fr;
    }
  }

</style>
