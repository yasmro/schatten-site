---
// Do / Don't panel of the guides. Fill the `dont` and `do` slots with real
// components.
import { Icon, Text } from '@yasmro/schatten'
import { Check, X } from 'lucide-react'
import { type Locale, ui } from '../i18n/ui'

interface Props {
  locale: Locale
}

const t = ui[Astro.props.locale].detail
---

<div class="guide__panel">
  <figure class="guide__side">
    <figcaption class="guide__label">
      <Icon icon={X} size="sm" color="error" />
      <Text as="span" variant="label" size="sm" color="error">{t.dontLabel}</Text>
    </figcaption>
    <div class="guide__stage"><slot name="dont" /></div>
  </figure>
  <figure class="guide__side">
    <figcaption class="guide__label">
      <Icon icon={Check} size="sm" color="success" />
      <Text as="span" variant="label" size="sm" color="success">{t.doLabel}</Text>
    </figcaption>
    <div class="guide__stage"><slot name="do" /></div>
  </figure>
</div>

<style is:global>
  /* LAYOUT only — type / color / controls come from the components. */
  .guide__panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-4);
    padding: var(--spacing-6);
    background: var(--color-surface-hover);
    border-radius: var(--radius-surface);
  }

  .guide__side {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .guide__label {
    display: flex;
    align-items: center;
    gap: var(--spacing-1);
  }

  .guide__stage {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    flex: 1;
    padding: var(--spacing-4);
    background: var(--color-background);
    border-radius: var(--radius-control);
  }

  .guide__stage > .st-table,
  .guide__stage > [class*='st-field'],
  .guide__stage > [class*='st-callout'],
  .guide__stage > .st-input {
    flex: 1 1 100%;
  }

  @media (max-width: 40rem) {
    .guide__panel {
      grid-template-columns: 1fr;
    }
  }
</style>
