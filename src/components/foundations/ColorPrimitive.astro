---
// Primitive colors: what a color is. Scales first, because most ink tokens are
// aliases of their rungs.
import {
  colorPage as c,
  colorScales,
  inkAndPaper,
  inkAndPaperInverted,
} from '../../i18n/foundations'
import type { Locale } from '../../i18n/ui'
import { aliasLine, hexOf } from '../../lib/color-labels.mjs'
import { listColorScales, listPrimitiveAliases } from '../../lib/library.mjs'
import Swatch from './Swatch.astro'
import SwatchGroup from './SwatchGroup.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const scales = listColorScales()
const aliases = listPrimitiveAliases()
const unknownScales = Object.keys(scales).filter((name) => !colorScales.some((s) => s.name === name))
if (unknownScales.length > 0) {
  throw new Error(
    `no entry for color scales: ${unknownScales.join(', ')} — update colorScales in src/i18n/foundations.ts`,
  )
}
---

{
  colorScales.map(({ name, title, note }) => (
    <SwatchGroup title={title[locale]} note={note?.[locale]}>
      {scales[name].map((step) => (
        <Swatch name={`${name}-${step}`} paint={`var(--${name}-${step})`} lines={[hexOf(`--${name}-${step}`)]} />
      ))}
    </SwatchGroup>
  ))
}

{
  [
    { title: c.inkTitle[locale], note: c.inkLead[locale], tokens: inkAndPaper },
    { title: c.inkInvertedTitle[locale], note: c.inkInvertedLead[locale], tokens: inkAndPaperInverted },
  ].map(({ title, note, tokens }) => (
    <SwatchGroup title={title} note={note} wide>
      {tokens.map(({ name }) => (
        <Swatch name={name} paint={`var(--${name})`} lines={[aliasLine(`--${name}`, aliases)]} />
      ))}
    </SwatchGroup>
  ))
}
