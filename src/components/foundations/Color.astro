---
// Color page, ordered the way colors flow: Primitive → Theme → Semantic, then
// how semantic colors combine. The diagram at the top is that flow.
import { Icon, Text } from '@yasmro/schatten'
import { ArrowRight } from 'lucide-react'
import { colorPage as c } from '../../i18n/foundations'
import type { Locale } from '../../i18n/ui'
import ColorCombinations from './ColorCombinations.astro'
import ColorPrimitive from './ColorPrimitive.astro'
import ColorSemantic from './ColorSemantic.astro'
import ColorTheme from './ColorTheme.astro'
import Section from './Section.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const sections = [
  { id: 'primitive', title: c.primitiveTitle, lead: c.primitiveLead, Content: ColorPrimitive },
  { id: 'theme', title: c.themeTitle, lead: c.themeLead, Content: ColorTheme },
  { id: 'semantic', title: c.semanticTitle, lead: c.semanticLead, Content: ColorSemantic },
  { id: 'combinations', title: c.combinationsTitle, lead: c.treatmentsLead, Content: ColorCombinations },
]
---

<div class="fnd__section">
  <ol class="fnd__flow">
    {
      c.flow.map(({ title, note }, i) => (
        <li>
          <span class="fnd__flow-box">
            <Text as="span" variant="label" size="sm">{title[locale]}</Text>
            <Text as="span" size="xs" color="muted">{note[locale]}</Text>
          </span>
          {i < c.flow.length - 1 && <Icon icon={ArrowRight} size="sm" color="subtle" />}
        </li>
      ))
    }
  </ol>
  <Text as="p" size="xs" color="muted" leading="relaxed" className="fnd__measure" set:html={c.approxNote[locale]} />
</div>

{
  sections.map(({ id, title, lead, Content }, i) => (
    <Section title={title[locale]} lead={lead[locale]} id={id} eyebrow={String(i + 1).padStart(2, '0')}>
      <Content locale={locale} />
    </Section>
  ))
}
