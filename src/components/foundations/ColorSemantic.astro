---
// Semantic colors, with what each one references in light and dark. The list
// is checked against the package both ways, every reference must be something
// the Primitive or Theme section shows, and no component may skip this layer
// to use a primitive directly (the page says so).
import {
  colorGroups,
  colorPage as c,
  inkAndPaper,
  inkAndPaperInverted,
} from '../../i18n/foundations'
import type { Locale } from '../../i18n/ui'
import { hexOf, short } from '../../lib/color-labels.mjs'
import {
  componentPrimitiveRefs,
  listColorReferences,
  listColorScales,
  listTokens,
} from '../../lib/library.mjs'
import Section from './Section.astro'
import Swatch from './Swatch.astro'
import SwatchGroup from './SwatchGroup.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const published = listTokens().color.map(({ name }) => name.slice('--color-'.length))
const listed = colorGroups.flatMap(({ tokens }) => tokens.map(({ name }) => name))
const mismatch = [
  ...published.filter((name) => !name.startsWith('theme-') && !listed.includes(name)),
  ...listed.filter((name) => !published.includes(name)),
]
if (mismatch.length > 0) {
  throw new Error(
    `color tokens out of step with the package: ${mismatch.join(', ')} — update colorGroups in src/i18n/foundations.ts`,
  )
}

const references = listColorReferences()
const primitives = new Set([
  ...[...inkAndPaper, ...inkAndPaperInverted].map(({ name }) => `--${name}`),
  ...Object.entries(listColorScales()).flatMap(([name, steps]) =>
    steps.map((step) => `--${name}-${step}`),
  ),
])
const unshown = listed
  .flatMap((name) => {
    const ref = references[`--color-${name}`]
    if (!ref) throw new Error(`no reference for --color-${name} in core/tokens/semantic.css`)
    return [ref.light, ref.dark]
  })
  .filter((target) => !target.startsWith('--color-theme-') && !primitives.has(target))
if (unshown.length > 0) {
  throw new Error(
    `semantic colors reference primitives the site does not show: ${unshown.join(', ')} — update src/i18n/foundations.ts`,
  )
}

const direct = componentPrimitiveRefs(primitives)
if (direct.length > 0) {
  throw new Error(
    `components use primitives directly, which the Color page says they do not: ${direct.join(', ')}`,
  )
}

const firstState = colorGroups.findIndex(({ tokens }) => tokens[0].name === 'destructive')
---

{
  colorGroups.map((group, i) => (
    <>
      {i === firstState && <Section title={c.stateTitle[locale]} lead={c.stateLead[locale]} level="h3" />}
      <SwatchGroup title={group.title[locale]} note={group.note?.[locale]} wide>
        {group.tokens.map(({ name, role }) => {
          const { light, dark } = references[`--color-${name}`]
          return (
            <Swatch
              name={`color-${name}`}
              paint={[`var(${light})`, `var(${dark})`]}
              lines={[
                role[locale],
                `${c.light[locale]} → ${short(light)} · ${hexOf(light)}`,
                `${c.dark[locale]} → ${short(dark)} · ${hexOf(dark)}`,
              ]}
            />
          )
        })}
      </SwatchGroup>
    </>
  ))
}
