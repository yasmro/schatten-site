---
// Brand webfonts via external Google Fonts injection — the same policy as the
// library itself: `src/themes/default/fonts.css` declares the family stacks
// but "Consumers must load these fonts themselves". The docs site is a
// consumer, so it injects the fonts externally rather than self-hosting.
//
// The URLs mirror `.storybook/preview-head.html` (the Storybook injection for
// the identical stacks) — keep the two in sync when a family/weight changes.
//
// `serif` opts in to the serif stack (EB Garamond / Noto Serif JP); most pages
// only need the sans stack Text/UI renders with.
interface Props {
  serif?: boolean
}

const { serif = false } = Astro.props
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap"
  rel="stylesheet"
/>
<link
  href="https://fonts.googleapis.com/css2?family=LINE+Seed+JP:wght@100;300;400;700;800&display=swap"
  rel="stylesheet"
/>
{
  serif && (
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Noto+Serif+JP:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  )
}

<style is:global>
  /* The second half of the consumer recipe (src/styles/entry.css §Font
   * configuration): the dist ships an unlayered
   * `:root { --font-sans: var(--font-sans-fallback) }` — system fonts by
   * default — and consumers who load brand fonts re-point the token.
   * Injecting the <link>s alone changes nothing; this override is what
   * makes the loaded fonts take effect.
   * (`--font-serif` needs no override: the dist keeps its brand-stack
   * default in @layer theme, so it activates as soon as the serif fonts
   * load.) */
  :root {
    --font-sans: "Hanken Grotesk", "LINE Seed JP", var(--font-sans-fallback);
  }
</style>
